PROJECT_NAME           = "LabGP"
PROJECT_BRIEF          = "Gestao de projetos de pesquisa"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO

INPUT                  = include src docs/architecture docs/adr docs/dai
FILE_PATTERNS          = *.hpp *.h *.cpp *.md
RECURSIVE              = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO

MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md
